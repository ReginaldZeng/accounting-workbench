# AI 网关（gateway.py，独立进程 8020）配置样例 —— V2.302
# 复制为同目录 .env 后填真值。真 key 只写服务器/本机 .env，勿提交、勿外发、勿进部署包。
# （.env 不在 pack_deploy 白名单里，天然不进包；.gitignore 亦已排除。）

# 管理令牌：核算后端代理凭证管理用（llm-hub → 网关 /admin/*）。
# 不配 = 管理面整体关闭（转发面不受影响）。生成：python -c "import secrets;print(secrets.token_hex(24))"
GW_ADMIN_TOKEN=

# 厂商 key（按工作台开独立账号，一台一把；网关按凭证归属路由）
GW_DEEPSEEK_API_KEY=
# GW_KIMI_API_KEY=
# GW_GLM_API_KEY=
# GW_DASHSCOPE_API_KEY=

# 全站日 token 硬闸（对任何凭证生效，0=不限）
GW_SITE_DAILY_TOKENS=5000000

# 供应商超时秒数（网关侧的闸，默认 90）
# GW_TIMEOUT=90
