; ============================================================
; conf.ini 模板（不含机密，可进库）。真实 conf.ini 被 .gitignore 忽略、放机密。
; 部署到服务器时：把本文件复制为 conf.ini 并填入真实值。
; ============================================================

[config]
; ===== 金蝶云星空 第三方应用 授权 =====
X-KDApi-AcctID    = <金蝶账套ID>
X-KDApi-UserName  = <API 用户名>   ; 建议用金蝶「系统操作员」等服务账号——机器写入的创建人即挂此账号，与真人手工录入天然区分
X-KDApi-AppID     = <第三方应用 AppID>
X-KDApi-AppSec    = <第三方应用 AppSecret>
X-KDApi-ServerUrl = https://<你的金蝶域名>/K3Cloud
X-KDApi-LCID      = 2052
X-KDApi-OrgNum    =

[rptexport]
; ===== 报表导出：导好的文件往哪儿放（兜底路径）=====
; ⚠ 这是**服务器上**的路径，不是使用者自己电脑上的路径——后端在服务器上写文件。
;   要让同事都拿得到，填一个服务器能写的共享位置（如 \\NAS\财务共享\月度报表），
;   并确认运行本工具的服务账号对它有写权限。
; 前端「报表导出 › 通知设置」里填了路径就用前端那个；**留空就回落到这里**。
out_dir =

[smtp]
; ===== 邮件通知（汇率录入自动跑批用；host 或 from 留空 = 不发邮件、仅记录、不报错）=====
; tls: ssl(端口465) | starttls(端口587) | none(端口25)
host      = smtp.exmail.qq.com
port      = 465
tls       = ssl
user      = <发件邮箱账号>
pwd       = <邮箱授权码/密码>
from      = <发件邮箱>
from_name = 汇率录入工具
; 收件人 / 抄送 / 密送（各自多个，用分号或逗号隔开；cc 进邮件头可见，bcc 隐藏但照发）
to        = <收件人1@example.com>; <收件人2@example.com>
cc        =
bcc       =

[dingtalk]
; ===== 钉钉工作通知（企业内部应用；appkey=ClientID, appsecret=ClientSecret, agentid=AgentId）=====
; 需在钉钉开发者后台给应用开通：①工作通知消息权限；②(用手机号收件时)根据手机号获取成员信息权限。
appkey     = <钉钉企业内部应用 ClientID>
appsecret  = <ClientSecret>
agentid    = <AgentId>
; 收件人：钉钉手机号(需开通手机号查成员权限) 或直接 userid，分号/逗号隔开
to_mobiles =
to_userids =

[notify]
; ===== 「通知设置」页改收发件人的口令（机密、不下发前端；前端提交口令→后端在此校验）=====
; 留空 = 页面暂不能改收发件人（需管理员在此设置口令后才开放）。收发件人本身存数据库、页面可改。
passcode = <设置一个改收发件人的口令>

[nav]
; ===== 能进入「开发中」状态模块的账号名单（V2.242）=====
; 「开发中」的模块在左侧导航上，只有这里列的人点得动，其他人一律灰显、点不进去。
; 用途：在建的东西自己要能进去看效果，但别让同事撞见半成品。
;
; 填账号名（就是登录名），逗号/分号/顿号隔开，例：
;   dev_users = 曾禹锡
;   dev_users = 曾禹锡, 张三
;
; 留空 = 回落到「所有主管理员都能进」（不是"谁都能进"，空名单绝不放行非管理员）。
;
; ⚠ 为什么放这里而不是放页面上：这份名单的用途是把范围收得【比主管理员还窄】。
;   一旦能在页面改，任何一个主管理员都能顺手把自己加回去，这个限制就等于没有。
;   放 conf.ini＝只有进得了服务器的人能改。
; ⚠ 它管的是【菜单点不点得动】，不挡接口。真要防人访问，用「账号管理」里的权限点。
dev_users =

; ============================================================
; 汇率自动跑批 相关环境变量（不放 conf.ini，放服务器环境变量）：
;   FX_AUTORUN=1        仅生产服务器设此值才启动"次月首个工作日14:00自动跑批"定时线程；
;                       本地/开发不设 → 不自动写金蝶，避免多实例重复录入。
;   FX_AUTORUN_ORGS=101 自动跑批的组织（逗号分隔），缺省 101。
;   FX_AUTORUN_HOUR=14  每日触发小时，缺省 14（下午2点）。
; ============================================================
