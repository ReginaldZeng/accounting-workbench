; ============================================================
; BOM 采购核算表取件机配置（装在成本会计电脑上）
; 复制本文件为 bom_pull.ini，填好三项即可。
; ============================================================

[pull]
; 云端工作台地址（平时打开工作台的那个网址，不要带末尾斜杠）
server = http://111.229.72.116

; BOM 专用取件码——必须与服务器 conf.ini 里 [bom] pull_token 完全一致（找管理员要）。
; 它只能取 outbox 里的采购核算表，取不了报表、登录不了工作台。纯英文字母数字 - _，别放中文或空格。
pull_token = <找管理员要；纯 ASCII，24 位以上随机串>

; 文件放到哪儿。默认桌面下的 BOM报价审核 文件夹（不存在会自动建）；会按 2026年\09月 再分子目录。
; 可用环境变量；也可以写共享盘 UNC 路径。
dest_dir = %USERPROFILE%\Desktop\BOM报价审核

; 单次请求超时（秒）
timeout = 45
