; ============================================================
; 银行流水上行取件机配置（跑在公司内网一台常开电脑上）
; 复制本文件为 bank_pull.ini，填好即可。与报表取件机(pull_reports.ini)互不干扰。
; ============================================================

[pull]
; 云端工作台地址（平时打开工作台的网址，不带末尾斜杠）
server = http://111.229.72.116

; 取件码——与服务器 conf.ini [rptexport] pull_token 完全一致（和报表取件机同一个码）。
; ⚠ 只能纯英文字母数字和 - _，别放中文或空格（走请求头传，非 ASCII 会静默 403）。
pull_token = <找管理员要；纯 ASCII，与报表取件同一个>

; 共享盘上【资金流水】的年目录——它下面是「5月流水 / 6月流水 / 2026年08月」这样的月子目录。
; ⚠ 建议用 UNC（\\10.10.8.251\...），别用盘符 Y:\——计划任务后台账号可能看不到映射盘。
src_root = \\10.10.8.251\starfield部门文件夹\永续风控中心\旧文件\财务部\风控AI中台导出文件包\银行流水测试\2026年

; 月子目录名只有"6月流水"没有年份时，年份取这里（一般填当前年）。目录名自带年份(2026年08月)则忽略本项。
year = 2026

; 稳定期（分钟）：一个月目录里的文件连续这么久大小/数量不再变，才认定"出纳传完了"，再推给服务器解析。
; 太短会解析到没传完的半个月数据（少账）；太长会拖慢。共享盘散件一次传完约几分钟，10 分钟稳妥。
; 页面点「立即扫描」时忽略本窗口、直接推。
settle_minutes = 10

; 单次请求超时（秒）。财资/回单 PDF 单个文件可能十几 MB，给足 60 秒。
timeout = 60
