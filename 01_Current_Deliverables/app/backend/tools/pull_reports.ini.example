; ============================================================
; 报表取件机配置（跑在公司内网一台常开电脑上）
; 复制本文件为 pull_reports.ini，填好三项即可。
; ============================================================

[pull]
; 云端工作台地址（就是你平时打开工作台的那个网址，不要带末尾斜杠）
server = http://111.229.72.116

; 取件码——必须与服务器 conf.ini 里 [rptexport] pull_token 完全一致。
; 这不是登录密码：它只能下载已导出的报表，登录不了工作台、动不了别的任何东西。
; ⚠ 只能用**纯英文字母、数字和 - _**，别放中文或空格：它是走 HTTP 请求头传的，
;   请求头传不了非 ASCII 字符——放了中文会静默失败，表现成"令牌明明填对了却一直 401"，
;   非常难查（V2.241 联调时实际踩过）。建议 24 位以上随机串，例如用这条生成：
;     python -c "import secrets;print(secrets.token_urlsafe(24))"
pull_token = <找管理员要；纯 ASCII，24 位以上随机串>

; 文件放到哪儿——共享盘上的目录。
; 这台电脑上能在资源管理器里打开的路径就行，盘符（Y:\...）或 UNC（\\10.10.8.251\...）都可以。
; ⚠ 建议用 UNC：盘符是"当前登录用户"的映射，计划任务用别的账号跑时可能看不到 Y 盘。
dest_dir = \\10.10.8.251\starfield部门文件夹\永续风控中心\旧文件\财务部\财务BP\测试

; 单次请求超时（秒）。101 主体的文件约 1.3 MB，45 秒绰绰有余。
; 别往大了调：任务每分钟跑一轮，单次卡得比这还久的话，一轮就跨到下一轮去了。
timeout = 45
